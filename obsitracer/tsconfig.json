{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "CommonJS",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": false,
		"strictNullChecks": true,
		"strictPropertyInitialization": false,
		"skipLibCheck": true,
		"types": ["node"],
		"lib": ["DOM", "ES5", "ES6", "ES7"],
		"ignoreDeprecations": "6.0"
	},
	"include": ["**/*.ts"]
}
